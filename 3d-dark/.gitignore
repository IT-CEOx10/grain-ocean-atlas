node_modules/
.DS_Store
*.log

# крупные медиа кладём вручную, в репозиторий не тащим
assets/video/*.mp4
# исключение: ролики шаров входного экрана «Маршруты экспорта» (по 3 МБ).
# Без них раздел собирается с пустыми шарами, поэтому они лежат в репозитории
!assets/video/globe-2016.mp4
!assets/video/globe-2025.mp4
dist/

# исходники фотографий (тяжёлые, в сборку идут сжатые WebP)
assets/photos/src/

# исходник Natural Earth для карты регионов (40 МБ, качается make_regions.py)
data/geo/ne_10m_admin_1_states_provinces.geojson

# оригинал NASA Blue Marble NG 21600×10800 (27 МБ). Из него make_earth_textures.py
# делает подложку суши всех размеров; ссылка на скачивание — в README,
# раздел «Текстуры Земли»
assets/textures/nasa_blue_marble_21600_src.jpg

# выгрузка из фигмы: исходники сцен и полные кадры (тяжёлые, в сборку идут WebP).
# Векторные детали (линии, подсветки, иконки) — наоборот, идут в сборку как есть
# и весят копейки, поэтому их оставляем в репозитории.
assets/concept/*
!assets/concept/svg/
